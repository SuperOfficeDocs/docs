      "SuperOffice.CRM.Services.Mention": {
        "description": "Mention carrier.\r\n<para />\r\nCarrier object for Mention.\r\nServices for the Mention Carrier is available from the <see cref=\"T:SuperOffice.CRM.Services.IMentionAgent\">Mention Agent</see>.",
        "type": "object",
        "properties": {
          "MentionId": {
            "format": "int32",
            "description": "Id of the mention row.",
            "type": "integer"
          },
          "MessageId": {
            "format": "int32",
            "description": "The request comment (ej_message) the mention was made in.",
            "type": "integer"
          },
          "TicketId": {
            "format": "int32",
            "description": "Id of the ticket the mention's comment belongs to.",
            "type": "integer"
          },
          "Title": {
            "description": "Display title for the item the mention was made in, combined server-side.",
            "type": "string"
          },
          "MentionedByAssociateId": {
            "format": "int32",
            "description": "The colleague who wrote the @mention.",
            "type": "integer"
          },
          "MentionedByFullName": {
            "description": "Display name of the colleague who wrote the @mention.",
            "type": "string"
          },
          "MentionedAssociateId": {
            "format": "int32",
            "description": "The colleague who was tagged.",
            "type": "integer"
          },
          "MentionedDate": {
            "format": "date-time",
            "description": "When the mention was created.  in UTC.",
            "type": "string"
          },
          "IsRead": {
            "description": "Whether the mentioned colleague has seen this mention.",
            "type": "boolean"
          },
          "Snippet": {
            "description": "Short snippet of the mentioned text.",
            "type": "string"
          },
          "TableRight": {
            "$ref": "#/components/schemas/SuperOffice.CRM.Security.TableRight"
          },
          "FieldProperties": {
            "description": "Field property dictionary mapping field names to field access rights.",
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/SuperOffice.CRM.Security.FieldProperty"
            }
          }
        }
