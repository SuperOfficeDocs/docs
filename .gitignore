# Personal AI configuration (private repo, not for all contributors)
ai-agents/
AGENTS.md
.github/copilot-instructions.md
.claude/launch.json

# Python bytecode cache (tools/*.py scripts)
__pycache__/

# Vale style packages downloaded via `vale sync` (see .vale.ini Packages=)
# — third-party content, not ours to commit. Run `vale sync` after cloning.
vale/Microsoft/
vale/.vale-config/

# tools/benchmarks/ (issue #90/#91 performance scripts) - npm deps and Lighthouse's own scratch
# output; committed results live under tools/benchmarks/results/, not here.
tools/benchmarks/node_modules/
tools/benchmarks/.lighthouseci/
tools/benchmarks/*.log
.scratch/

# Pester's default NUnit-XML report (`Invoke-Pester -CI` writes this to the cwd) - a local test
# run artifact, not something to commit.
testResults.xml
